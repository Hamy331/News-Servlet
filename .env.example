# Chép file này thành .env khi chạy ở máy cá nhân (trên Render thì khai báo ở mục Environment)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<ten_db>?retryWrites=true&w=majority
JWT_SECRET=doi_chuoi_bi_mat_nay

# development: khi gửi mail lỗi, trang Quên mật khẩu hiện luôn link đặt lại (tiện khi test)
# production: ẩn link đó (Dockerfile đã đặt sẵn NODE_ENV=production)
NODE_ENV=development

# Gửi mail (chọn 1 trong 2, có thể bỏ trống nếu chưa cần)
SENDGRID_API_KEY=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
