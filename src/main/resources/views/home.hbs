<link rel="stylesheet" href="/css/magazine.css">
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

<div class="mz-page py-5">
  <div class="container">

    <!-- ================= HERO ================= -->
    <div class="row g-4 g-lg-5">
      <!-- Bài chính + 2 bài phụ -->
      <div class="col-lg-8" data-aos="fade-up" data-aos-duration="900">
        {{#if article1}}
        <a href="/details?id={{article1._id}}" class="mz-lead mz-hover d-block">
          <div class="mz-thumb">
            {{#if article1.articleType}}{{#if (eq article1.articleType 'hot')}}<span class="mz-badge">{{formatType article1.articleType}}</span>{{/if}}{{/if}}
            <img src="{{article1.image_url.[0]}}" alt="{{article1.title}}"
                 onerror="this.onerror=null;this.src='https://placehold.co/1200x700/eeeeee/999999?text=No+Image';">
          </div>
          <div class="mz-lead-body">
            {{#if article1.category.name}}<span class="mz-kicker">{{article1.category.name}}</span>{{/if}}
            <h1 class="mz-headline mz-headline--xl">{{article1.title}}</h1>
            {{#if article1.summary}}<p class="mz-summary mz-clamp-3">{{article1.summary}}</p>{{/if}}
            <div class="mz-meta">
              {{#if article1.author.username}}<span><i class="bi bi-pen"></i>{{article1.author.username}}</span>{{/if}}
              <span><i class="bi bi-calendar3"></i>{{formatDate (or article1.publishedAt article1.createdAt)}}</span>
              <span><i class="bi bi-eye"></i>{{article1.views}}</span>
            </div>
          </div>
        </a>
        {{/if}}

        <div class="row g-4 mz-sub">
          {{#if article2}}
          <div class="col-md-6">
            <a href="/details?id={{article2._id}}" class="mz-hover d-block">
              <div class="mz-thumb">
                <img src="{{article2.image_url.[0]}}" alt="{{article2.title}}"
                     onerror="this.onerror=null;this.src='https://placehold.co/600x400/eeeeee/999999?text=No+Image';">
              </div>
              {{#if article2.category.name}}<span class="mz-kicker">{{article2.category.name}}</span>{{/if}}
              <h3 class="mz-headline mz-headline--md mz-clamp-3">{{article2.title}}</h3>
              <div class="mz-meta mt-2">
                <span><i class="bi bi-calendar3"></i>{{formatDate (or article2.publishedAt article2.createdAt)}}</span>
                <span><i class="bi bi-eye"></i>{{article2.views}}</span>
              </div>
            </a>
          </div>
          {{/if}}
          {{#if article3}}
          <div class="col-md-6">
            <a href="/details?id={{article3._id}}" class="mz-hover d-block">
              <div class="mz-thumb">
                <img src="{{article3.image_url.[0]}}" alt="{{article3.title}}"
                     onerror="this.onerror=null;this.src='https://placehold.co/600x400/eeeeee/999999?text=No+Image';">
              </div>
              {{#if article3.category.name}}<span class="mz-kicker">{{article3.category.name}}</span>{{/if}}
              <h3 class="mz-headline mz-headline--md mz-clamp-3">{{article3.title}}</h3>
              <div class="mz-meta mt-2">
                <span><i class="bi bi-calendar3"></i>{{formatDate (or article3.publishedAt article3.createdAt)}}</span>
                <span><i class="bi bi-eye"></i>{{article3.views}}</span>
              </div>
            </a>
          </div>
          {{/if}}
        </div>
      </div>

      <!-- Mới cập nhật -->
      <aside class="col-lg-4" data-aos="fade-left" data-aos-duration="900">
        <div class="mz-ticker">
          <h5 class="mz-side-title mz-side-title--red"><i class="bi bi-lightning-charge-fill me-1"></i> Mới cập nhật</h5>
          {{#each newest5Articles}}
          <a href="/details?id={{this._id}}" class="mz-ticker-item mz-hover">
            <div>
              {{#if this.category.name}}<span class="mz-kicker mb-1">{{this.category.name}}</span>{{/if}}
              <h4 class="mz-headline mz-headline--sm mz-clamp-3">{{this.title}}</h4>
              <div class="mz-meta mt-2"><span><i class="bi bi-clock"></i>{{formatDate (or this.publishedAt this.createdAt)}}</span></div>
            </div>
          </a>
          {{else}}
          <p class="text-muted fst-italic">Chưa có bài viết.</p>
          {{/each}}
          <a href="/latest" class="d-block text-center fw-semibold py-3 border-top mz-section-link">Xem tất cả tin mới <i class="bi bi-arrow-right"></i></a>
        </div>
      </aside>
    </div>

    <!-- ================= TIN MỚI NHẤT (SLIDER) ================= -->
    {{#if newestArticles.length}}
    <section class="mz-section" data-aos="fade-up" data-aos-duration="1000">
      <div class="mz-section-head">
        <h2 class="mz-section-title">Tin mới nhất</h2>
        <a href="/latest" class="mz-section-link">Xem tất cả <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="position-relative px-1">
        <div class="owl-carousel owl-theme mz-slider" id="mz-latest-slider">
          {{#each newestArticles}}
          <div class="mz-slide">
            <a href="/details?id={{this._id}}" class="mz-card mz-hover">
              <div class="mz-thumb">
                <img src="{{this.image_url.[0]}}" alt="{{this.title}}"
                     onerror="this.onerror=null;this.src='https://placehold.co/600x400/eeeeee/999999?text=No+Image';">
              </div>
              <div class="mz-card-body">
                {{#if this.category.name}}<span class="mz-kicker">{{this.category.name}}</span>{{/if}}
                <h3 class="mz-headline mz-headline--md mz-clamp-3">{{this.title}}</h3>
                <div class="mz-meta">
                  <span><i class="bi bi-calendar3"></i>{{formatDate (or this.publishedAt this.createdAt)}}</span>
                  <span><i class="bi bi-eye"></i>{{this.views}}</span>
                </div>
              </div>
            </a>
          </div>
          {{/each}}
        </div>
      </div>
    </section>
    {{/if}}

    <!-- ================= TIÊU ĐIỂM CHUYÊN MỤC ================= -->
    {{#if latestArticlesFromCategories.length}}
    <section class="mz-section" data-aos="fade-up" data-aos-duration="1000">
      <div class="mz-section-head">
        <h2 class="mz-section-title">Tiêu điểm chuyên mục</h2>
      </div>
      <div class="row g-4">
        {{#each latestArticlesFromCategories}}
        <div class="col-sm-6 col-lg-4">
          <a href="/details?id={{this._id}}" class="mz-card mz-hover">
            <div class="mz-thumb">
              {{#if this.category.name}}<span class="mz-badge mz-badge--dark">{{this.category.name}}</span>{{/if}}
              <img src="{{this.image_url.[0]}}" alt="{{this.title}}"
                   onerror="this.onerror=null;this.src='https://placehold.co/600x400/eeeeee/999999?text=No+Image';">
            </div>
            <div class="mz-card-body">
              <h3 class="mz-headline mz-headline--md mz-clamp-3">{{this.title}}</h3>
              {{#if this.summary}}<p class="mz-summary mz-clamp-2" style="font-size:0.92rem">{{this.summary}}</p>{{/if}}
              <div class="mz-meta">
                <span><i class="bi bi-calendar3"></i>{{formatDate (or this.publishedAt this.createdAt)}}</span>
                <span><i class="bi bi-eye"></i>{{this.views}}</span>
              </div>
            </div>
          </a>
        </div>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <!-- ================= ĐỌC NHIỀU NHẤT ================= -->
    {{#if topViewedArticles.length}}
    <section class="mz-section" data-aos="fade-up" data-aos-duration="1000">
      <div class="mz-section-head">
        <h2 class="mz-section-title">Đọc nhiều nhất</h2>
      </div>
      <div class="mz-rank">
        {{#each topViewedArticles}}
        <a href="/details?id={{this._id}}" class="mz-rank-item mz-hover">
          <div class="mz-rank-body">
            {{#if this.category.name}}<span class="mz-kicker mb-1">{{this.category.name}}</span>{{/if}}
            <h4 class="mz-headline mz-headline--sm mz-clamp-2">{{this.title}}</h4>
            <div class="mz-meta mt-1"><span><i class="bi bi-eye"></i>{{this.views}} lượt xem</span></div>
          </div>
          <div class="mz-thumb">
            <img src="{{this.image_url.[0]}}" alt=""
                 onerror="this.onerror=null;this.src='https://placehold.co/200x150/eeeeee/999999?text=No+Image';">
          </div>
        </a>
        {{/each}}
      </div>
    </section>
    {{/if}}

  </div>
</div>

<script>
  AOS.init({ once: true });

  // jQuery + Owl được nạp ở cuối layout, nên đợi DOMContentLoaded
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof $ === "undefined" || !$.fn.owlCarousel) return;
    $("#mz-latest-slider").owlCarousel({
      loop: false,
      margin: 22,
      nav: true,
      navText: ["<i class='bi bi-chevron-left'></i>", "<i class='bi bi-chevron-right'></i>"],
      dots: true,
      autoplay: true,
      autoplayTimeout: 4500,
      autoplayHoverPause: true,
      responsive: { 0: { items: 1 }, 576: { items: 2 }, 992: { items: 3 }, 1200: { items: 4 } }
    });
  });
</script>
