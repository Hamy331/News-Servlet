{{!-- Lịch sử xử lý — tham số: items, showReviewer (true = hiện cột người xử lý, dùng cho Admin) --}}
{{#if items.length}}
<div class="table-responsive">
  <table class="table wk-table wk-datatable align-middle">
    <thead>
      <tr>
        <th>Bài viết</th>
        <th>Chuyên mục</th>
        <th>Kết quả</th>
        {{#if showReviewer}}<th>Người xử lý</th>{{/if}}
        <th>Thời gian</th>
        <th>Ghi chú</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>
          <div class="wk-article">
            <img class="wk-thumb" src="{{this.image_url.[0]}}" alt=""
                 onerror="this.onerror=null;this.src='https://placehold.co/144x104/eeeeee/999999?text=No+Image';">
            <div>
              {{#if (eq this.status 'published')}}
              <a href="/details?id={{this._id}}" target="_blank" class="wk-article-title">{{this.title}}</a>
              {{else}}
              <div class="wk-article-title">{{this.title}}</div>
              {{/if}}
              <div class="wk-article-sum">bởi {{#if this.author.username}}{{this.author.username}}{{else}}—{{/if}}</div>
            </div>
          </div>
        </td>
        <td><span class="wk-pill wk-pill--cat">{{this.category.name}}</span></td>
        <td>
          {{#if (eq this.status 'published')}}
          <span class="wk-pill wk-pill--published"><i class="bi bi-check2"></i> Đã duyệt</span>
          <div class="wk-meta mt-1">{{formatType this.articleType}}</div>
          {{else}}
          <span class="wk-pill wk-pill--rejected"><i class="bi bi-x"></i> Từ chối</span>
          {{/if}}
        </td>
        {{#if ../showReviewer}}
        <td>
          {{#if this.approver}}
          <div class="fw-semibold text-dark">{{this.approver.username}}</div>
          <span class="wk-pill wk-pill--{{this.approver.role}}" style="font-size:10px">{{this.approver.role}}</span>
          {{else}}—{{/if}}
        </td>
        {{/if}}
        <td class="wk-meta">{{formatDate this.updatedAt}}</td>
        <td>{{#if (eq this.status 'rejected')}}<div class="wk-note">“{{this.rejectionNote}}”</div>{{else}}<span class="wk-meta">—</span>{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<div class="wk-empty">
  <div class="wk-empty-icon"><i class="bi bi-clock-history"></i></div>
  <h5>Chưa có lịch sử</h5>
  <p class="mb-0">Các bài đã duyệt hoặc từ chối sẽ được ghi lại tại đây.</p>
</div>
{{/if}}
