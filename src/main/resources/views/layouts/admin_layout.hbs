<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{#if title}}{{title}} · {{/if}}GR6 NEWS Workspace</title>

    <link rel="stylesheet" href="/css/categoryNavbar.css">
    <link rel="stylesheet" href="/css/writer.css">
    <link rel="stylesheet" href="/css/administrator.css">

    <!-- Bootstrap, Icons & Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/revision.css">

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
</head>

<body style="background-color: #fbfbfb; font-family: 'Inter', sans-serif;">

    <!-- THANH ĐIỀU HƯỚNG WORKSPACE -->
    <header class="ws-bar gn-scope">
        <div class="gn-wrap">
            <div class="ws-brand">
                <a href="/" class="gn-logo-text" aria-label="Về trang báo">GR6 <b>NEWS</b></a>
                <span class="ws-divider"></span>
                <span class="ws-label">Workspace</span>
            </div>

            <nav class="ws-nav" aria-label="Workspace">
                {{#if isWriter}}
                <a href="/writer" class="ws-link {{#if (eq writerTab 'compose')}}is-active{{/if}}"><i class="bi bi-pen"></i><span>Viết bài</span></a>
                <a href="/writer/articles" class="ws-link {{#if (eq writerTab 'articles')}}is-active{{/if}}"><i class="bi bi-journal-text"></i><span>Bài của tôi</span></a>
                {{/if}}
                {{#if isEditor}}
                <a href="/editor" class="ws-link {{#if (eq navSection 'editor')}}is-active{{/if}}"><i class="bi bi-journal-check"></i><span>Duyệt bài</span></a>
                {{/if}}
                {{#if isAdmin}}
                <a href="/administrator" class="ws-link {{#if (eq navSection 'administrator')}}is-active{{/if}}"><i class="bi bi-speedometer2"></i><span>Bảng quản trị</span></a>
                {{/if}}
                <a href="/user/profile" class="ws-link {{#if (eq navSection 'user')}}is-active{{/if}}"><i class="bi bi-person"></i><span>Hồ sơ</span></a>
            </nav>

            <div class="ws-right">
                <a href="/" class="ws-view-site"><i class="bi bi-box-arrow-up-right"></i><span>Xem trang báo</span></a>

                {{#if authUser}}
                <!-- CHUÔNG THÔNG BÁO -->
                <div class="dropdown">
                    <button class="nt-bell" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" aria-label="Thông báo{{#if notifUnread}} ({{notifUnread}} chưa đọc){{/if}}">
                        <i class="bi bi-bell"></i>
                        {{#if notifUnread}}<span class="nt-badge">{{notifUnread}}</span>{{/if}}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end gn-menu nt-menu">
                        <div class="nt-head">
                            <strong>Thông báo</strong>
                            {{#if notifUnread}}
                            <form action="/notifications/read-all" method="post" class="m-0"><button type="submit">Đánh dấu đã đọc</button></form>
                            {{/if}}
                        </div>
                        <div class="nt-list">
                            {{#each notifications}}
                            <a href="/notifications/{{this._id}}" class="nt-item {{#unless this.read}}is-unread{{/unless}}">
                                <span class="nt-icon"><i class="bi
                                    {{#if (eq this.type 'approved')}}bi-check2-circle{{else if (eq this.type 'revision_approved')}}bi-check2-all{{else if (eq this.type 'rejected')}}bi-x-circle{{else if (eq this.type 'revision_rejected')}}bi-x-octagon{{else if (eq this.type 'revision_submitted')}}bi-pencil-square{{else if (eq this.type 'resubmitted')}}bi-arrow-repeat{{else if (eq this.type 'edited')}}bi-pencil{{else}}bi-send{{/if}}"></i></span>
                                <span>{{this.message}}<time>{{timeAgo this.createdAt}}</time></span>
                            </a>
                            {{else}}
                            <div class="nt-empty"><i class="bi bi-bell-slash d-block fs-4 mb-2"></i>Chưa có thông báo nào</div>
                            {{/each}}
                        </div>
                    </div>
                </div>
                {{/if}}

                {{#if authUser}}
                <div class="dropdown">
                    <button class="gn-user" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="gn-avatar">{{getFirstLetter authUser.username}}</span>
                        <span class="ws-user-name">{{authUser.username}}</span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end gn-menu">
                        <li class="gn-menu-head">
                            <div class="gn-name">{{authUser.username}}</div>
                            <span class="ws-role ws-role--{{authUser.role}} mt-1">{{authUser.role}}</span>
                        </li>
                        <li><a class="dropdown-item" href="/user/profile"><i class="bi bi-person"></i> Hồ sơ cá nhân</a></li>
                        <li><a class="dropdown-item" href="/"><i class="bi bi-newspaper"></i> Trang báo</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="/auth/logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item is-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
                {{/if}}
            </div>
        </div>
    </header>

    <main>{{{body}}}</main>

</body>
</html>
